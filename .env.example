# Optional. Everything works without this file. Copy it to .env to change a
# default; `docker compose` reads .env automatically.

# Ports on your machine (unusual on purpose, to avoid clashes):
FRONTEND_PORT=4710
BACKEND_PORT=4711
DB_PORT=4712

# Database login:
DB_NAME=bookings
DB_USER=bookings
DB_PASSWORD=bookings

# Requests handled at once = WEB_WORKERS x WEB_THREADS (keep it below 100).
WEB_WORKERS=4
WEB_THREADS=8

# Production only. With these set, `python manage.py check --deploy` reports no issues.
# DJANGO_SECRET_KEY=a-long-random-string
# DJANGO_HTTPS=1
# DJANGO_ALLOWED_HOSTS=bookings.example.com
